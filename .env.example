# Database — PostgreSQL connection string (e.g. Neon via Vercel Storage, Supabase,
# or a local Postgres). Tables are created by `npx prisma migrate deploy`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Session signing secret — generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-64-char-hex-string"

# Base URL used for Stripe redirect URLs
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Stripe — get test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe webhook signing secret — printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."
